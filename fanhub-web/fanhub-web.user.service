[Unit]
Description=MKS Fan Hub web interface
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/technic47/fanhub-web
Environment=FANHUB_CONFIG=/home/technic47/fanhub-web/config.json
ExecStart=/home/technic47/fanhub-web/.venv/bin/python -m fanhub_web
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
